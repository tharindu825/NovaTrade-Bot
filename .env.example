# ====================================================================
#  NovaTrade-Bot Environment Configuration
#  All variables are strictly validated on startup with Zod.
# ====================================================================

# --------------------------------------------------------------------
# 1. BYBIT V5 DEMO TRADING API CREDENTIALS
# --------------------------------------------------------------------
# Generate your Demo Trading API Key from Bybit -> Demo Trading -> API Management
BYBIT_API_KEY=your_bybit_demo_api_key_here
BYBIT_API_SECRET=your_bybit_demo_api_secret_here
BYBIT_DEMO_TRADING=true
BYBIT_RECV_WINDOW=5000
BYBIT_ENABLE_TIME_SYNC=true

# --------------------------------------------------------------------
# 2. OPENROUTER AI CONFIGURATION (RISK & SENTIMENT FILTER)
# --------------------------------------------------------------------
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free/Ultra-efficient models available on OpenRouter:
# - meta-llama/llama-3.3-70b-instruct:free
# - google/gemini-2.0-flash-lite:free
# - google/gemini-2.0-flash-001
# - deepseek/deepseek-r1:free
# - qwen/qwen-2.5-72b-instruct:free
OPENROUTER_PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL=google/gemini-2.0-flash-001
# Minimum AI confidence score (0-100) required to authorize a trade execution
OPENROUTER_MIN_CONFIDENCE=75
OPENROUTER_TIMEOUT_MS=30000
# Toggle AI evaluation layer on/off (if false, executes purely on technical rules)
AI_ENABLED=true

# --------------------------------------------------------------------
# 3. TRADING & STRATEGY ENGINE PARAMETERS
# --------------------------------------------------------------------
# Comma-separated list of symbols to trade or scan (or "AUTO_SCAN" to scan top by volume)
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,NEARUSDT,SUIUSDT,ADAUSDT
# Scanner execution loop in minutes (e.g. 15 matches 15m candle close)
SCAN_INTERVAL_MINUTES=15
# Trigger timeframe in minutes for entry signals (15 = 15m klines)
TRIGGER_TIMEFRAME=15
# Trend timeframe in minutes for macro trend confirmation (60 = 1h klines, 240 = 4h klines)
TREND_TIMEFRAME=60
# Leverage for USDT Linear Perpetual contracts (e.g. 3, 5, 10)
LEVERAGE=5
# Account equity risk percentage per trade (e.g. 1.5 = risk 1.5% of total balance on SL)
POSITION_RISK_PERCENT=1.5
# Maximum concurrent open positions allowed
MAX_OPEN_POSITIONS=3
# Minimum 24h quote volume in USDT to filter illiquid pairs (10,000,000 = $10M)
MIN_24H_VOLUME_USDT=10000000
# Maximum allowed bid-ask spread percentage
MAX_SPREAD_PERCENT=0.08

# --------------------------------------------------------------------
# 4. TAKE PROFIT & STOP LOSS MULTI-STAGE AUTOMATION
# --------------------------------------------------------------------
# Multiplier of ATR for Stop Loss distance calculation
SL_ATR_MULTIPLIER=1.5
# Take Profit 1 Risk-to-Reward ratio (e.g. 1.3 means TP1 distance = 1.3 * SL distance)
TP1_RR_RATIO=1.3
# Take Profit 2 Risk-to-Reward ratio (e.g. 2.6 means TP2 distance = 2.6 * SL distance)
TP2_RR_RATIO=2.6
# Fraction of position to close when TP1 is reached (0.5 = 50%)
TP1_CLOSE_RATIO=0.5
# Automatically move Stop Loss to Entry Price (Breakeven) once TP1 is hit
MOVE_SL_TO_BREAKEVEN_ON_TP1=true

# --------------------------------------------------------------------
# 5. REAL-TIME NEWS & MACRO SENTIMENT SOURCES
# --------------------------------------------------------------------
# News ingestion frequency in minutes
NEWS_FETCH_INTERVAL_MINUTES=15
# Enable Free RSS News Feeds (CoinTelegraph, CoinDesk, Decrypt)
ENABLE_RSS_NEWS=true
# Comma-separated RSS feeds
RSS_FEED_URLS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
# Optional: CryptoPanic API Token (Free registration at cryptopanic.com/developers/api)
CRYPTOPANIC_API_KEY=
# Enable Alternative.me Fear & Greed Index
ENABLE_FEAR_GREED_INDEX=true

# --------------------------------------------------------------------
# 6. NOTIFICATIONS & STORAGE
# --------------------------------------------------------------------
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Local JSON / SQLite storage file for persistence
STORAGE_FILE_PATH=./data/trades.json
# Optional Discord Webhook URL for real-time trade & AI alerts
DISCORD_WEBHOOK_URL=
# Optional Telegram Bot Token & Chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
